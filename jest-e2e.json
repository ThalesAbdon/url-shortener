{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "tests/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "collectCoverage": true,
  "coverageProvider": "v8",
  "collectCoverageFrom": [
    "src/urls/urls.controller.ts"
  ],
  "coverageReporters": ["text"],
  "coverageDirectory": "./coverage-e2e"
}